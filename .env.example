# Diagram Forge — Environment Variables
# Copy this file to .env and fill in your values.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string
DATABASE_URL="mongodb://localhost:27017/diagram_forge"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign JWTs — change this in production
JWT_SECRET=change-me-in-production-use-at-least-32-chars

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Provider selection is automatic:
#   If GEMINI_API_KEY is set   → Gemini is used
#   If OPENAI_API_KEY is set   → OpenAI is used
#   Otherwise                  → Mock provider (good for dev/testing)

# Google Gemini
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Model to use per provider (optional — defaults shown)
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o

# ─── File Storage ─────────────────────────────────────────────────────────────
# Local uploads directory (relative to backend process cwd)
UPLOAD_DIR=./uploads
# Max upload size in bytes (default: 10 MB)
MAX_UPLOAD_SIZE=10485760
# Allowed upload MIME types / extensions (comma-separated)
ALLOWED_EXTENSIONS=.yaml,.yml,.json,.env,.dockerfile,.txt

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
# Max generation requests per minute per IP
RATE_LIMIT_GENERATION=10
# Max general API requests per minute per IP
RATE_LIMIT_API=120
